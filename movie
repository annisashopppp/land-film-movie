<!DOCTYPE html>
<html lang="id">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Love Movier - Streaming & Cinema Hub</title>
  <meta name="description" content="Corporate streaming platform with real-time movie metadata, official HD trailers, 2026 releases, and interactive cinema rooms." />
  
  <!-- Tailwind CSS CDN -->
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            brand: {
              red: '#e50914',
              hover: '#b80710',
              dark: '#0b0b0e',
              card: '#121318',
            }
          }
        }
      }
    };
  </script>

  <!-- Google Fonts & Lucide Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&family=Outfit:wght@500;700;800;900&display=swap" rel="stylesheet">
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    body {
      font-family: 'Plus Jakarta Sans', sans-serif;
      transition: background-color 0.25s ease, color 0.25s ease;
    }
    .font-brand {
      font-family: 'Outfit', sans-serif;
    }
    /* Hide scrollbar for clean carousel */
    .no-scrollbar::-webkit-scrollbar {
      display: none;
    }
    .no-scrollbar {
      -ms-overflow-style: none;
      scrollbar-width: none;
    }
  </style>
</head>
<body class="bg-[#0b0b0e] text-slate-100 antialiased selection:bg-red-600 selection:text-white dark">

  <!-- ==================== TOP NAVBAR ==================== -->
  <header id="mainNavbar" class="sticky top-0 z-40 w-full transition-colors border-b backdrop-blur-md px-4 sm:px-8 py-3 flex items-center justify-between gap-4 bg-[#0b0b0e]/90 border-slate-800/80 text-white">
    <!-- Brand Logo -->
    <div class="flex items-center gap-6">
      <button onclick="switchView('home')" class="flex items-center gap-2.5 group focus:outline-none text-left">
        <div class="w-8 h-8 rounded-lg bg-red-600 flex items-center justify-center text-white shadow-md shadow-red-600/30 group-hover:bg-red-500 transition-colors">
          <i data-lucide="film" class="w-4 h-4"></i>
        </div>
        <div class="flex flex-col">
          <span id="logoText" class="text-lg font-black tracking-wider leading-none font-brand text-white">
            LOVE <span class="text-red-600">MOVIER</span>
          </span>
        </div>
      </button>

      <!-- Center Links -->
      <nav class="hidden md:flex items-center gap-6 text-sm font-medium">
        <button onclick="filterCatalog('movies')" class="hover:text-red-500 transition-colors py-1">Movies</button>
        <button onclick="filterCatalog('tv')" class="hover:text-red-500 transition-colors py-1">TV Shows</button>
        <button onclick="switchView('watchlist')" class="hover:text-red-500 transition-colors py-1">My List</button>
      </nav>
    </div>

    <!-- Right Controls -->
    <div class="flex items-center gap-3 sm:gap-5">
      <!-- Live Real-Time Clock -->
      <div class="hidden lg:flex flex-col text-right pr-3 border-r border-slate-700/60">
        <span id="clockTime" class="text-xs font-bold text-white tracking-wide font-mono">12:30 PM</span>
        <span id="clockDate" class="text-[10px] text-slate-400 font-medium">17th June 2026</span>
      </div>

      <!-- Live Search Filter -->
      <div class="relative">
        <i data-lucide="search" class="w-4 h-4 text-slate-400 absolute left-3 top-1/2 -translate-y-1/2 pointer-events-none"></i>
        <input
          id="searchInput"
          type="text"
          oninput="handleSearch(this.value)"
          placeholder="Search movie, director, 2026..."
          class="w-36 sm:w-56 md:w-64 pl-9 pr-3 py-1.5 text-xs rounded-full border border-slate-700 bg-slate-900/90 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-red-500 focus:w-72 transition-all"
        />
      </div>

      <!-- Night & Light Mode Toggle -->
      <button
        id="themeToggleBtn"
        onclick="toggleTheme()"
        class="flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold rounded-full border border-slate-700 bg-slate-800 text-amber-300 hover:bg-slate-700 transition-all"
        title="Toggle Night/Light Mode"
      >
        <i id="themeIcon" data-lucide="moon" class="w-3.5 h-3.5"></i>
        <span id="themeLabel" class="hidden sm:inline">Night</span>
      </button>

      <!-- Notification Bell -->
      <div class="relative">
        <button onclick="toggleNotificationMenu()" class="p-2 rounded-full border border-slate-700 bg-slate-800 text-slate-300 hover:text-white transition-colors relative">
          <i data-lucide="bell" class="w-4 h-4"></i>
          <span class="absolute -top-1 -right-1 w-4 h-4 rounded-full bg-red-600 text-white text-[10px] font-bold flex items-center justify-center">2</span>
        </button>

        <div id="notificationDropdown" class="hidden absolute right-0 mt-2 w-72 rounded-xl shadow-2xl border border-slate-700 bg-[#0f1015] p-3 z-50 text-white">
          <div class="flex items-center justify-between pb-2 mb-2 border-b border-slate-800">
            <span class="text-xs font-bold uppercase tracking-wider">Notifications</span>
            <span class="text-[10px] text-red-500 cursor-pointer font-semibold" onclick="showToast('Semua notifikasi ditandai telah dibaca')">Tandai Dibaca</span>
          </div>
          <div class="space-y-2 text-xs">
            <div class="p-2 rounded-lg bg-red-500/10 border border-red-500/20 cursor-pointer" onclick="handleCardClick('dune-part-three')">
              <p class="font-bold text-red-400">🔥 Premier 2026 Tersedia</p>
              <p class="text-[11px] text-slate-300">Trailer 4K HDR Dune: Messiah kini resmi tayang!</p>
            </div>
            <div class="p-2 rounded-lg bg-slate-800/40 cursor-pointer" onclick="switchView('parties')">
              <p class="font-semibold">Undangan Watch Party</p>
              <p class="text-[11px] text-slate-400">Marcus mengundang Anda ke Money Heist Finale Party.</p>
            </div>
          </div>
        </div>
      </div>

      <!-- User Profile -->
      <button onclick="switchView('setting')" class="relative focus:outline-none">
        <img
          src="https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=120&q=80"
          alt="Avatar"
          class="w-8 h-8 rounded-full object-cover ring-2 ring-red-500/50 hover:ring-red-500 transition-all"
        />
      </button>
    </div>
  </header>

  <!-- ==================== MAIN 3-COLUMN WRAPPER ==================== -->
  <div class="flex-1 flex max-w-[1720px] w-full mx-auto">
    
    <!-- ==================== 1. LEFT SIDEBAR ==================== -->
    <aside id="mainSidebar" class="w-60 shrink-0 border-r border-slate-800/80 min-h-[calc(100vh-65px)] p-4 flex flex-col justify-between hidden md:flex bg-[#0d0e12] text-slate-300">
      <div class="space-y-6">
        <div>
          <span class="text-[11px] font-bold tracking-wider uppercase text-slate-500 px-3 mb-2 block">Navigation Menu</span>
          <nav class="space-y-1">
            <button onclick="switchView('home')" id="nav-home" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold bg-red-600 text-white shadow-md shadow-red-600/30">
              <div class="flex items-center gap-3">
                <i data-lucide="home" class="w-4 h-4"></i>
                <span>Home</span>
              </div>
            </button>
            <button onclick="switchView('watchlist')" id="nav-watchlist" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="bookmark" class="w-4 h-4"></i>
                <span>Watch List</span>
              </div>
              <span id="watchlistBadge" class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-600 text-white">2</span>
            </button>
            <button onclick="switchView('coming_soon')" id="nav-coming_soon" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="calendar" class="w-4 h-4"></i>
                <span>Coming Soon</span>
              </div>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-600 text-white">2026</span>
            </button>
            <button onclick="switchView('discovery')" id="nav-discovery" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="compass" class="w-4 h-4"></i>
                <span>Discovery</span>
              </div>
            </button>
            <button onclick="switchView('friends')" id="nav-friends" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="users" class="w-4 h-4"></i>
                <span>Friends</span>
              </div>
            </button>
            <button onclick="switchView('parties')" id="nav-parties" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="tv" class="w-4 h-4"></i>
                <span>Parties</span>
              </div>
              <span class="px-1.5 py-0.5 rounded text-[10px] font-bold bg-red-500/20 text-red-400 animate-pulse">Live</span>
            </button>
            <button onclick="switchView('media')" id="nav-media" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="film" class="w-4 h-4"></i>
                <span>Media</span>
              </div>
            </button>
            <button onclick="switchView('setting')" id="nav-setting" class="sidebar-btn w-full flex items-center justify-between px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-400 hover:bg-slate-800/60 hover:text-white">
              <div class="flex items-center gap-3">
                <i data-lucide="settings" class="w-4 h-4"></i>
                <span>Setting</span>
              </div>
            </button>
          </nav>
        </div>

        <div class="p-3 rounded-xl border border-slate-800 bg-slate-900/40">
          <div class="flex items-center gap-2 mb-1 text-xs font-bold text-red-400">
            <i data-lucide="flame" class="w-3.5 h-3.5"></i>
            <span>2026 Premiere Season</span>
          </div>
          <p class="text-[11px] text-slate-400">Nikmati streaming trailer eksklusif & info film 2026 kualitas 4K UHD.</p>
        </div>
      </div>

      <!-- Backlink & Attribution Sesuai Instruksi -->
      <div class="pt-4 border-t border-slate-800/60 space-y-1.5 text-[11px] text-slate-500">
        <span class="text-slate-400 font-medium">Partner Resmi:</span>
        <a href="https://www.aannisaputriiiiy.store" target="_blank" rel="noopener noreferrer" class="text-red-400 hover:text-red-300 font-bold flex items-center justify-between">
          <span>aannisaputriiiiystore</span>
          <i data-lucide="external-link" class="w-3 h-3"></i>
        </a>
        <span class="text-[10px] text-slate-500 block">20Backlink_Gratis</span>
      </div>
    </aside>

    <!-- ==================== 2. MAIN CONTENT ==================== -->
    <main id="mainContainer" class="flex-1 p-4 md:p-6 lg:p-8 overflow-y-auto max-w-full">
      
      <!-- HOME VIEW -->
      <section id="view-home" class="view-panel space-y-8">
        
        <!-- Hero Section (Matches Money Heist photo) -->
        <div class="relative w-full min-h-[460px] md:min-h-[520px] rounded-2xl overflow-hidden flex flex-col justify-end p-6 md:p-12 mb-8">
          <div class="absolute inset-0 z-0">
            <img
              id="heroBackdrop"
              src="/assets/aistudio/original-4bc427960ed2e1b849ef14cae71c454a_90e92c24.webp"
              alt="Money Heist"
              class="w-full h-full object-cover object-center filter brightness-90 contrast-105"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-[#0b0b0e] via-[#0b0b0e]/70 to-transparent"></div>
            <div class="absolute inset-0 bg-gradient-to-r from-[#0b0b0e] via-[#0b0b0e]/80 to-transparent md:w-3/4"></div>
          </div>

          <div class="relative z-10 max-w-2xl space-y-4">
            <h1 id="heroTitle" class="text-4xl md:text-5xl lg:text-6xl font-extrabold tracking-tight text-white drop-shadow-md">
              Money Heist
            </h1>

            <p id="heroMeta" class="text-sm md:text-base font-medium text-slate-300 flex items-center gap-2">
              <span>2017</span>
              <span class="text-slate-500">·</span>
              <span>4 seasons, 31 episodes</span>
              <span class="text-slate-500">·</span>
              <span class="flex items-center gap-1 text-amber-400 font-bold">
                <i data-lucide="star" class="w-3.5 h-3.5 fill-current"></i>
                <span>4.8</span>
              </span>
            </p>

            <!-- Hero Sub-Tabs -->
            <div class="flex items-center gap-6 pt-2 border-b border-white/10 pb-2 text-sm font-medium">
              <button onclick="setHeroTab('story')" id="tab-story" class="hero-tab text-white font-semibold relative pb-1">
                The Story
                <span class="tab-indicator absolute bottom-0 left-0 right-0 h-0.5 bg-red-600"></span>
              </button>
              <button onclick="setHeroTab('director')" id="tab-director" class="hero-tab text-slate-400 hover:text-white relative pb-1">
                Director
              </button>
              <button onclick="setHeroTab('reviews')" id="tab-reviews" class="hero-tab text-slate-400 hover:text-white relative pb-1">
                Reviews (147)
              </button>
            </div>

            <!-- Hero Tab Content -->
            <div id="heroTabDesc" class="min-h-[56px] text-sm md:text-[15px] leading-relaxed text-slate-300">
              Eight thieves take hostages and lock themselves in the Royal Mint of Spain as a criminal mastermind manipulates the police to carry out his plan.
            </div>

            <!-- Action Buttons -->
            <div class="flex items-center gap-3 pt-2">
              <button
                onclick="handleWatchHero()"
                class="flex items-center gap-2.5 px-7 py-3 rounded-full bg-red-600 hover:bg-red-700 text-white font-bold text-sm tracking-wide transition-all shadow-xl shadow-red-600/30 hover:scale-[1.03]"
              >
                <i data-lucide="play" class="w-4 h-4 fill-current"></i>
                <span>Continue watching</span>
              </button>

              <button
                id="heroWatchlistBtn"
                onclick="toggleHeroWatchlist()"
                aria-label="Add to Watchlist"
                class="p-3 rounded-full backdrop-blur-md border border-white/20 bg-white/10 text-white hover:text-red-400 transition-all"
              >
                <i data-lucide="heart" class="w-5 h-5"></i>
              </button>

              <button
                onclick="handleWatchHero()"
                class="hidden sm:flex items-center gap-1.5 px-4 py-3 rounded-full bg-black/40 hover:bg-black/60 text-slate-300 hover:text-white border border-white/10 text-xs font-semibold backdrop-blur-md"
              >
                <i data-lucide="info" class="w-4 h-4"></i>
                <span>Trailer & Details</span>
              </button>
            </div>
          </div>
        </div>

        <!-- Section "You May Interested" -->
        <div class="space-y-4">
          <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
            <h3 class="text-xl md:text-2xl font-bold tracking-tight text-white flex items-center gap-2">
              <span>You May Interested</span>
            </h3>

            <div class="flex items-center gap-3">
              <div class="flex items-center gap-1 p-1 rounded-lg text-xs bg-slate-900/80 border border-slate-800">
                <button onclick="filterSubCatalog('all')" id="sub-all" class="sub-filter-btn px-3 py-1 rounded-md font-medium bg-red-600 text-white">All</button>
                <button onclick="filterSubCatalog('new_release')" id="sub-new" class="sub-filter-btn px-3 py-1 rounded-md font-medium text-slate-400 hover:text-white">New Release</button>
                <button onclick="filterSubCatalog('2026')" id="sub-2026" class="sub-filter-btn px-3 py-1 rounded-md font-medium text-slate-400 hover:text-white">2026 Lineup</button>
              </div>

              <button onclick="toggleViewMore()" class="text-xs font-semibold text-red-400 hover:text-red-300 transition-colors flex items-center gap-1">
                <span id="viewMoreLabel">View More</span>
                <i data-lucide="chevron-right" class="w-3.5 h-3.5"></i>
              </button>
            </div>
          </div>

          <!-- Cards Carousel / Grid -->
          <div id="movieCardGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4">
            <!-- Dynamically populated via JS -->
          </div>
        </div>

        <!-- ==================== BANNER_HORIZONTAL (728x90) PERSIS DI BAWAH NEW RELEASE ==================== -->
        <div class="w-full my-6 flex flex-col items-center">
          <div class="flex items-center justify-between w-full max-w-[760px] px-2 mb-1.5 text-[11px] text-slate-500">
            <span class="flex items-center gap-1 font-medium uppercase tracking-wider">
              <i data-lucide="sparkles" class="w-3 h-3 text-red-500"></i>
              Sponsored Partner (Horizontal 728x90)
            </span>
            <a href="https://auctionr.org/4/bc5a285e6424bacbc0fc127a2b91360d" target="_blank" rel="noopener noreferrer" class="hover:text-red-400 text-slate-400 flex items-center gap-1">
              <span>Claim VIP Streaming Pass</span>
              <i data-lucide="external-link" class="w-2.5 h-2.5"></i>
            </a>
          </div>

          <div
            onclick="triggerDirectLink()"
            class="relative w-full max-w-[760px] min-h-[96px] rounded-xl border border-slate-800 bg-slate-900/60 p-1.5 flex items-center justify-center cursor-pointer overflow-hidden transition-all hover:border-red-500/40"
          >
            <!-- Script Iklan 728x90 Sesuai Prompt -->
            <div id="ad-container-horizontal" class="overflow-hidden flex items-center justify-center max-w-full"></div>
            <div class="absolute inset-0 bg-transparent"></div>
          </div>
        </div>

        <!-- 2026 Upcoming Premieres Section -->
        <div class="pt-2">
          <div class="flex items-center justify-between mb-4">
            <div class="flex items-center gap-2">
              <i data-lucide="sparkles" class="w-4 h-4 text-red-500"></i>
              <h3 class="text-lg font-bold text-white">2026 Upcoming Movie Premieres</h3>
            </div>
            <button onclick="switchView('coming_soon')" class="text-xs font-semibold text-red-400 hover:underline flex items-center gap-1">
              <span>Jadwal Lengkap 2026</span>
              <i data-lucide="arrow-right" class="w-3 h-3"></i>
            </button>
          </div>

          <div id="upcoming2026Grid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
            <!-- Dynamically populated via JS -->
          </div>
        </div>
      </section>

      <!-- WATCH LIST VIEW -->
      <section id="view-watchlist" class="view-panel hidden space-y-6">
        <div class="flex items-center justify-between border-b border-slate-800 pb-4">
          <div>
            <h2 class="text-2xl font-bold flex items-center gap-2">
              <i data-lucide="bookmark" class="w-6 h-6 text-red-500 fill-current"></i>
              <span>My Streaming Watch List</span>
            </h2>
            <p class="text-xs text-slate-400 mt-1">Daftar film yang Anda simpan untuk sesi nonton selanjutnya.</p>
          </div>
          <button onclick="clearWatchlist()" class="px-3 py-1.5 rounded-lg border border-red-500/30 text-red-400 hover:bg-red-500/10 text-xs font-semibold">
            Clear All
          </button>
        </div>
        <div id="watchlistGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"></div>
      </section>

      <!-- COMING SOON 2026 VIEW -->
      <section id="view-coming_soon" class="view-panel hidden space-y-8">
        <div class="p-6 md:p-8 rounded-2xl bg-gradient-to-r from-red-950/80 via-slate-900 to-black border border-red-900/40">
          <span class="px-3 py-1 rounded-full bg-red-600 text-white text-xs font-bold uppercase tracking-wider">Lineup Resmi 2026</span>
          <h2 class="text-3xl md:text-4xl font-extrabold text-white mt-2">Upcoming Blockbusters 2026</h2>
          <p class="text-xs md:text-sm text-slate-300 mt-2 max-w-xl">
            Saksikan trailer resmi dan premiere film-film terbesar tahun 2026 seperti Dune: Messiah, Avatar 3, Spider-Verse, dan Avengers: Doomsday dalam kualitas 4K Dolby Atmos.
          </p>
        </div>
        <div id="comingSoonFullGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4"></div>
      </section>

      <!-- DISCOVERY & REAL-TIME API SEARCH VIEW -->
      <section id="view-discovery" class="view-panel hidden space-y-6">
        <div>
          <h2 class="text-2xl font-bold flex items-center gap-2">
            <i data-lucide="compass" class="w-6 h-6 text-red-500"></i>
            <span>Discovery & Real-Time Movie Lookup</span>
          </h2>
          <p class="text-xs text-slate-400 mt-1">Cari film apa saja secara langsung ke API film publik untuk sinopsis, sutradara, aktor & trailer real-time.</p>
        </div>

        <!-- API Form -->
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 space-y-3">
          <form onsubmit="searchMovieApi(event)" class="flex gap-2">
            <input
              id="apiSearchTerm"
              type="text"
              placeholder="Ketik judul film apa saja (contoh: Inception, Avatar, Gladiator II, Batman)..."
              class="flex-1 px-4 py-2 text-xs rounded-xl border border-slate-700 bg-black/60 text-white placeholder-slate-500 focus:outline-none focus:ring-2 focus:ring-red-500"
            />
            <button type="submit" class="px-5 py-2 rounded-xl bg-red-600 hover:bg-red-700 text-white font-semibold text-xs shrink-0">
              Query Live API
            </button>
          </form>
          <div id="apiResultContainer" class="hidden"></div>
        </div>

        <div id="discoveryCatalogGrid" class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-4"></div>
      </section>

      <!-- FRIENDS VIEW -->
      <section id="view-friends" class="view-panel hidden space-y-6">
        <div class="border-b border-slate-800 pb-4">
          <h2 class="text-2xl font-bold flex items-center gap-2">
            <i data-lucide="users" class="w-6 h-6 text-red-500"></i>
            <span>Friends & Social Activity</span>
          </h2>
