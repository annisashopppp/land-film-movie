      const activePanel = document.getElementById(`view-${viewId}`);
      if (activePanel) activePanel.classList.remove('hidden');

      // Update sidebar active buttons
      document.querySelectorAll('.sidebar-btn').forEach(btn => {
        btn.classList.remove('bg-red-600', 'text-white', 'shadow-md', 'shadow-red-600/30');
        btn.classList.add('text-slate-400');
      });
      const currentNav = document.getElementById(`nav-${viewId}`);
      if (currentNav) {
        currentNav.classList.remove('text-slate-400');
        currentNav.classList.add('bg-red-600', 'text-white', 'shadow-md', 'shadow-red-600/30');
      }

      if (viewId === 'watchlist') renderWatchlistView();
      if (viewId === 'coming_soon') renderComingSoonView();
      if (viewId === 'discovery') renderDiscoveryView();
      if (viewId === 'friends') renderFriendsView();
      if (viewId === 'parties') renderPartiesView();
      if (viewId === 'media') renderMediaView();

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // 5. RENDER CARD ITEM
    function createMovieCardHTML(movie, isActive = false) {
      const isFav = userWatchlist.includes(movie.id);
      return `
        <div onclick="handleCardClick('${movie.id}')" class="group relative flex flex-col cursor-pointer transition-all duration-300 transform hover:-translate-y-1.5 rounded-xl ${isActive ? 'ring-2 ring-red-600 shadow-lg shadow-red-900/40' : ''}">
          <div class="relative aspect-[16/10] w-full overflow-hidden rounded-xl bg-slate-900">
            <img src="${movie.backdrop || movie.poster}" alt="${movie.title}" class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105" loading="lazy">
            <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-black/20 to-transparent"></div>
            
            ${movie.is2026 ? '<span class="absolute top-2 left-2 px-2 py-0.5 rounded bg-red-600 text-white font-extrabold text-[10px] tracking-wider uppercase">2026 New</span>' : ''}
            
            <button onclick="toggleWatchlistMovie('${movie.id}', event)" class="absolute top-2 right-2 p-1.5 rounded-full backdrop-blur-md transition-all ${isFav ? 'bg-red-600 text-white' : 'bg-black/60 text-slate-300 hover:bg-red-600 hover:text-white'}">
              <i data-lucide="${isFav ? 'check' : 'plus'}" class="w-3 h-3"></i>
            </button>

            <div class="absolute bottom-2.5 left-2.5 flex items-center justify-center">
              <div class="w-7 h-7 rounded-full bg-white/20 backdrop-blur-md flex items-center justify-center border border-white/40 group-hover:bg-red-600 group-hover:border-red-600 transition-colors">
                <i data-lucide="play" class="w-3.5 h-3.5 text-white fill-current translate-x-0.5"></i>
              </div>
            </div>
            ${isActive ? '<div class="absolute bottom-0 left-0 right-0 h-1 bg-red-600"></div>' : ''}
          </div>

          <div class="pt-2 px-0.5 space-y-1">
            <h4 class="text-sm font-semibold truncate text-slate-100 group-hover:text-red-400 transition-colors">${movie.title}</h4>
            <div class="flex items-center gap-1.5 text-xs text-amber-400">
              <i data-lucide="star" class="w-3 h-3 fill-current"></i>
              <span class="text-[11px] text-slate-400 font-mono">${movie.reviewsCount} reviews</span>
            </div>
          </div>
        </div>
      `;
    }

    // 6. KLIK KARTU FILM & DUAL FUNCTION (MODAL + DIRECT_LINK)
    function handleCardClick(movieId) {
      triggerDirectLink(); // Rule: Buka direct link di tab baru
      const movie = MOVIES_DATABASE.find(m => m.id === movieId);
      if (movie) {
        openVideoModal(movie);
      }
    }

    function handleWatchHero() {
      triggerDirectLink();
      openVideoModal(activeHeroMovie);
    }

    // 7. PEMUTAR VIDEO MODAL
    function openVideoModal(movie) {
      currentModalMovie = movie;
      document.getElementById('modalTitle').textContent = movie.title;
      document.getElementById('modalSynopsis').textContent = movie.synopsis;
      document.getElementById('modalDirector').textContent = movie.director;
      document.getElementById('modalCast').textContent = movie.cast;
      
      document.getElementById('modalMeta').innerHTML = `
        <span class="text-amber-400 font-bold flex items-center gap-1"><i data-lucide="star" class="w-3 h-3 fill-current"></i> ${movie.rating}</span>
        <span>·</span>
        <span>${movie.year}</span>
        <span>·</span>
        <span>${movie.seasonInfo || '2h 15m'}</span>
      `;

      const iframe = document.getElementById('modalIframe');
      iframe.src = `https://www.youtube-nocookie.com/embed/${movie.trailerYoutubeId}?autoplay=1&rel=0`;

      updateModalFavBtn();
      document.getElementById('videoModal').classList.remove('hidden');
      lucide.createIcons();
    }

    function closeVideoModal() {
      document.getElementById('videoModal').classList.add('hidden');
      document.getElementById('modalIframe').src = '';
    }

    function toggleModalFavorite() {
      if (currentModalMovie) {
        toggleWatchlistMovie(currentModalMovie.id);
        updateModalFavBtn();
      }
    }

    function updateModalFavBtn() {
      if (!currentModalMovie) return;
      const btn = document.getElementById('modalFavBtn');
      const isFav = userWatchlist.includes(currentModalMovie.id);
      if (isFav) {
        btn.className = 'p-2.5 rounded-full bg-red-600 text-white shadow-lg shadow-red-600/30';
      } else {
        btn.className = 'p-2.5 rounded-full backdrop-blur-md border border-white/20 bg-black/60 text-slate-200 hover:text-white';
      }
    }

    // 8. WATCHLIST SYSTEM
    function toggleWatchlistMovie(movieId, e) {
      if (e) e.stopPropagation();
      const movie = MOVIES_DATABASE.find(m => m.id === movieId);
      const title = movie ? movie.title : 'Film';
      if (userWatchlist.includes(movieId)) {
        userWatchlist = userWatchlist.filter(id => id !== movieId);
        showToast(`Dihapus dari Watch List: "${title}"`);
      } else {
        userWatchlist.push(movieId);
        showToast(`Ditambahkan ke Watch List: "${title}"`);
      }
      document.getElementById('watchlistBadge').textContent = userWatchlist.length;
      renderHomeCards();
      renderUpcomingCards();
      renderWatchlistView();
      lucide.createIcons();
    }

    function toggleHeroWatchlist() {
      toggleWatchlistMovie(activeHeroMovie.id);
      const btn = document.getElementById('heroWatchlistBtn');
      const isFav = userWatchlist.includes(activeHeroMovie.id);
      btn.className = isFav
        ? 'p-3 rounded-full bg-red-600 text-white border-red-500 shadow-lg shadow-red-600/30'
        : 'p-3 rounded-full backdrop-blur-md border border-white/20 bg-white/10 text-white hover:text-red-400';
    }

    function clearWatchlist() {
      userWatchlist = [];
      document.getElementById('watchlistBadge').textContent = '0';
      renderWatchlistView();
      showToast('Watchlist berhasil dikosongkan');
    }

    // 9. HERO TAB SWITCHER
    function setHeroTab(tab) {
      document.querySelectorAll('.hero-tab').forEach(b => {
        b.classList.remove('text-white', 'font-semibold');
        b.classList.add('text-slate-400');
        const ind = b.querySelector('.tab-indicator');
        if (ind) ind.remove();
      });

      const current = document.getElementById(`tab-${tab}`);
      current.classList.remove('text-slate-400');
      current.classList.add('text-white', 'font-semibold');
      current.innerHTML += '<span class="tab-indicator absolute bottom-0 left-0 right-0 h-0.5 bg-red-600"></span>';

      const desc = document.getElementById('heroTabDesc');
      if (tab === 'story') {
        desc.textContent = activeHeroMovie.synopsis;
      } else if (tab === 'director') {
        desc.innerHTML = `<strong class="text-white">${activeHeroMovie.director}</strong> (Sutradara/Kreator). Dibintangi oleh ${activeHeroMovie.cast}.`;
      } else if (tab === 'reviews') {
        desc.innerHTML = `Rating <span class="text-amber-400 font-bold">${activeHeroMovie.rating}/5.0</span> dari ${activeHeroMovie.reviewsCount} kritikus internasional. Pujian luar biasa untuk pacing dan ketegangan karakternya.`;
      }
    }

    // 10. LIVE SEARCH FILTER
    function handleSearch(term) {
      const q = term.trim().toLowerCase();
      const filtered = MOVIES_DATABASE.filter(m => 
        m.title.toLowerCase().includes(q) ||
        m.director.toLowerCase().includes(q) ||
        m.cast.toLowerCase().includes(q)
      );

      const grid = document.getElementById('movieCardGrid');
      grid.innerHTML = filtered.map(m => createMovieCardHTML(m, m.id === 'love-death-robots')).join('');
      lucide.createIcons();
    }

    // 11. SUB FILTER & VIEW MORE
    function filterSubCatalog(subType) {
      document.querySelectorAll('.sub-filter-btn').forEach(b => {
        b.className = 'sub-filter-btn px-3 py-1 rounded-md font-medium text-slate-400 hover:text-white';
      });
      document.getElementById(`sub-${subType}`).className = 'sub-filter-btn px-3 py-1 rounded-md font-medium bg-red-600 text-white';

      let list = MOVIES_DATABASE;
      if (subType === 'new_release') list = list.filter(m => m.year === '2021' || m.year === '2020' || m.is2026);
      if (subType === '2026') list = list.filter(m => m.is2026);

      const grid = document.getElementById('movieCardGrid');
      grid.innerHTML = (isViewMoreExpanded ? list : list.slice(0, 5)).map(m => createMovieCardHTML(m, m.id === 'love-death-robots')).join('');
      lucide.createIcons();
    }

    function toggleViewMore() {
      isViewMoreExpanded = !isViewMoreExpanded;
      document.getElementById('viewMoreLabel').textContent = isViewMoreExpanded ? 'Show Less' : 'View More';
      triggerDirectLink();
      renderHomeCards();
      showToast(isViewMoreExpanded ? 'Menampilkan semua film & koleksi 2026!' : 'Menampilkan rekomendasi teratas');
    }

    // 12. NIGHT & LIGHT MODE TOGGLE
    function toggleTheme() {
      const body = document.body;
      const isDark = body.classList.contains('dark');
      const label = document.getElementById('themeLabel');
      const logo = document.getElementById('logoText');

      if (isDark) {
        // Switch to Light
        body.classList.remove('dark', 'bg-[#0b0b0e]', 'text-slate-100');
        body.classList.add('light', 'bg-[#f8fafc]', 'text-slate-900');
        label.textContent = 'Light';
        logo.classList.remove('text-white');
        logo.classList.add('text-slate-900');
      } else {
        // Switch to Dark
        body.classList.remove('light', 'bg-[#f8fafc]', 'text-slate-900');
        body.classList.add('dark', 'bg-[#0b0b0e]', 'text-slate-100');
        label.textContent = 'Night';
        logo.classList.remove('text-slate-900');
        logo.classList.add('text-white');
      }
      lucide.createIcons();
    }

    // 13. TOAST NOTIFICATION
    function showToast(msg) {
      const toast = document.getElementById('toastNotification');
      document.getElementById('toastMsg').textContent = msg;
      toast.classList.remove('hidden');
      setTimeout(() => {
        toast.classList.add('hidden');
      }, 3000);
    }

    function toggleNotificationMenu() {
      const menu = document.getElementById('notificationDropdown');
      menu.classList.toggle('hidden');
    }

    // 14. REAL-TIME MOVIE API SEARCH (OMDB/PUBLIC FALLBACK)
    async function searchMovieApi(e) {
      e.preventDefault();
      const query = document.getElementById('apiSearchTerm').value.trim();
      if (!query) return;

      const container = document.getElementById('apiResultContainer');
      container.classList.remove('hidden');
      container.innerHTML = '<div class="p-3 text-slate-400 text-xs">Menghubungi API real-time...</div>';

      try {
        const res = await fetch(`https://www.omdbapi.com/?t=${encodeURIComponent(query)}&apikey=trilogy`);
        const data = await res.json();
        if (data.Response === 'True') {
          container.innerHTML = `
            <div class="p-4 rounded-xl border border-red-500/40 bg-red-950/20 flex flex-col md:flex-row gap-4 mt-2">
              ${data.Poster !== 'N/A' ? `<img src="${data.Poster}" class="w-24 h-36 object-cover rounded-lg shadow-md shrink-0">` : ''}
              <div class="space-y-1.5 text-xs flex-1">
                <h4 class="text-base font-bold text-white">${data.Title} (${data.Year})</h4>
                <p class="text-slate-300">${data.Plot}</p>
                <p class="text-slate-400"><strong>Director:</strong> ${data.Director} | <strong>Cast:</strong> ${data.Actors}</p>
                <button onclick="triggerDirectLink()" class="mt-2 inline-flex items-center gap-1.5 px-4 py-1.5 rounded-full bg-red-600 hover:bg-red-700 text-white font-semibold text-xs shadow-md">
                  <i data-lucide="play" class="w-3.5 h-3.5 fill-current"></i>
                  <span>Putar Trailer & Stream 4K</span>
                </button>
              </div>
            </div>
          `;
          showToast(`Data real-time untuk "${data.Title}" berhasil dimuat!`);
        } else {
          container.innerHTML = `<div class="p-3 rounded-lg bg-amber-500/10 text-amber-400 text-xs">Film tidak ditemukan di live API. Silakan coba judul lain.</div>`;
        }
      } catch (err) {
        container.innerHTML = `<div class="p-3 rounded-lg bg-red-500/10 text-red-400 text-xs">Koneksi API eksternal terbatas. Silakan pilih film dari katalog kami.</div>`;
      }
      lucide.createIcons();
    }

    // 15. LIVE CHAT SYSTEM UNTUK WATCH PARTIES
    const partyChat = ['Tokyo: Polisi sudah mengepung gedung!', 'Professor: Tetap tenang, rencana Paris sedang berjalan.', 'Berlin: Bella Ciao, kawan!'];
    function renderChat() {
      const container = document.getElementById('chatMessages');
      if (container) {
        container.innerHTML = partyChat.map(m => `<div class="p-2 rounded-lg bg-slate-800/40 border border-slate-700/40"><p class="text-slate-200">${m}</p></div>`).join('');
      }
    }
    function handleSendChat(e) {
      e.preventDefault();
      const input = document.getElementById('chatInput');
      if (!input.value.trim()) return;
      partyChat.push(`Anda: ${input.value.trim()}`);
      input.value = '';
      renderChat();
    }

    // 16. POPULATE KONTEN SEMUA VIEW
    function renderHomeCards() {
      const grid = document.getElementById('movieCardGrid');
      const list = isViewMoreExpanded ? MOVIES_DATABASE : MOVIES_DATABASE.slice(0, 5);
      grid.innerHTML = list.map(m => createMovieCardHTML(m, m.id === 'love-death-robots')).join('');
    }

    function renderUpcomingCards() {
      const grid = document.getElementById('upcoming2026Grid');
      const list2026 = MOVIES_DATABASE.filter(m => m.is2026).slice(0, 4);
      grid.innerHTML = list2026.map(m => createMovieCardHTML(m)).join('');
    }

    function renderWatchlistView() {
      const grid = document.getElementById('watchlistGrid');
      const saved = MOVIES_DATABASE.filter(m => userWatchlist.includes(m.id));
      if (saved.length === 0) {
        grid.innerHTML = '<div class="col-span-full py-16 text-center text-slate-400 text-xs">Watchlist Anda masih kosong. Tekan tombol "+" pada film untuk menyimpannya.</div>';
      } else {
        grid.innerHTML = saved.map(m => createMovieCardHTML(m)).join('');
      }
      lucide.createIcons();
    }

    function renderComingSoonView() {
      const grid = document.getElementById('comingSoonFullGrid');
      const list2026 = MOVIES_DATABASE.filter(m => m.is2026);
      grid.innerHTML = list2026.map(m => createMovieCardHTML(m)).join('');
      lucide.createIcons();
    }

    function renderDiscoveryView() {
      const grid = document.getElementById('discoveryCatalogGrid');
      grid.innerHTML = MOVIES_DATABASE.map(m => createMovieCardHTML(m)).join('');
      lucide.createIcons();
    }

    function renderFriendsView() {
      const container = document.getElementById('friendsListContainer');
      const friends = [
        { name: 'Sarah Jenkins', avatar: 'https://images.unsplash.com/photo-1494790108377-be9c29b29330?auto=format&fit=crop&w=150&q=80', action: 'sedang menonton', movie: 'Money Heist S4:E7', time: '12m yang lalu' },
        { name: 'Marcus Chen', avatar: 'https://images.unsplash.com/photo-1507003211169-0a1dd7228f2d?auto=format&fit=crop&w=150&q=80', action: 'memberi 5 bintang ke', movie: 'Dune: Messiah 2026', time: '45m yang lalu' },
        { name: 'Elena Rostova', avatar: 'https://images.unsplash.com/photo-1534528741775-53994a69daeb?auto=format&fit=crop&w=150&q=80', action: 'memulai party di', movie: 'Stranger Things 5', time: '1 jam yang lalu' },
      ];
      container.innerHTML = friends.map(f => `
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 flex items-center justify-between">
          <div class="flex items-center gap-3">
            <img src="${f.avatar}" class="w-10 h-10 rounded-full object-cover ring-2 ring-red-500/40">
            <div>
              <p class="text-xs font-semibold text-slate-200"><span class="text-white font-bold">${f.name}</span> ${f.action} <span class="text-red-400">${f.movie}</span></p>
              <span class="text-[10px] text-slate-500">${f.time}</span>
            </div>
          </div>
          <button onclick="triggerDirectLink()" class="px-3 py-1.5 rounded-lg bg-red-600/20 text-red-400 hover:bg-red-600 hover:text-white border border-red-500/30 text-xs font-semibold">
            Nonton Bareng
          </button>
        </div>
      `).join('');
      lucide.createIcons();
    }

    function renderPartiesView() {
      const container = document.getElementById('partiesListContainer');
      const parties = [
        { title: 'Money Heist Climax Marathon', host: 'The Professor Fanclub', viewers: '1,420', movie: 'Money Heist' },
        { title: '2026 Sci-Fi Teaser Breakdown', host: 'CinemaHub HQ', viewers: '890', movie: 'Dune: Messiah' },
      ];
      container.innerHTML = parties.map(p => `
        <div class="p-4 rounded-xl border border-slate-800 bg-slate-900/60 flex items-center justify-between">
          <div>
            <span class="px-2 py-0.5 rounded bg-red-600 text-white text-[10px] font-bold uppercase">LIVE</span>
            <h4 class="text-base font-bold text-white mt-1">${p.title}</h4>
            <p class="text-xs text-slate-400">${p.movie} · Host: ${p.host} · ${p.viewers} penonton</p>
          </div>
          <button onclick="triggerDirectLink()" class="px-4 py-2 rounded-lg bg-red-600 hover:bg-red-700 text-white font-semibold text-xs shadow-md">
            Gabung Room
          </button>
        </div>
      `).join('');
      renderChat();
      lucide.createIcons();
    }

    function renderMediaView() {
      const container = document.getElementById('mediaGrid');
      container.innerHTML = MOVIES_DATABASE.map(m => `
        <div onclick="handleCardClick('${m.id}')" class="group rounded-xl overflow-hidden border border-slate-800 bg-slate-900/60 cursor-pointer">
          <div class="relative aspect-video w-full bg-black">
            <img src="${m.backdrop}" class="w-full h-full object-cover group-hover:scale-105 transition-all">
            <div class="absolute inset-0 bg-black/40 flex items-center justify-center">
              <div class="w-10 h-10 rounded-full bg-red-600 text-white flex items-center justify-center shadow-lg">
                <i data-lucide="play" class="w-4 h-4 fill-current translate-x-0.5"></i>
              </div>
            </div>
          </div>
          <div class="p-3">
            <h4 class="text-sm font-bold text-white group-hover:text-red-400">${m.title}</h4>
            <p class="text-xs text-slate-400">${m.director} · ${m.year}</p>
          </div>
        </div>
      `).join('');
      lucide.createIcons();
    }

    function renderSidebarExtras() {
      // Popular Movies
      const popContainer = document.getElementById('popularMoviesContainer');
      const pop = [
        { id: 'money-heist', title: 'Money Heist', cat: 'Crime / Drama', rating: 4.8 },
        { id: 'dune-part-three', title: 'Dune: Messiah', cat: 'Sci-Fi', rating: 4.9 },
        { id: 'spiderman-beyond-spiderverse', title: 'Spider-Verse', cat: 'Animation', rating: 5.0 },
        { id: 'queens-gambit', title: "The Queen's Gambit", cat: 'Drama', rating: 4.9 }
      ];
      popContainer.innerHTML = pop.map((item, idx) => `
        <div onclick="handleCardClick('${item.id}')" class="flex items-center justify-between p-2 rounded-xl cursor-pointer hover:bg-slate-800/80 transition-all group">
          <div class="flex items-center gap-2.5">
            <span class="text-xs font-bold text-slate-500 font-mono w-4">0${idx+1}</span>
            <div>
              <h5 class="text-xs font-semibold group-hover:text-red-400 transition-colors line-clamp-1">${item.title}</h5>
              <p class="text-[10px] text-slate-400">${item.cat}</p>
            </div>
          </div>
          <span class="flex items-center text-[10px] text-amber-400 font-bold">
            <i data-lucide="star" class="w-2.5 h-2.5 fill-current mr-0.5"></i> ${item.rating}
          </span>
        </div>
      `).join('');

      // Favorites
      const favContainer = document.getElementById('favoritesContainer');
      const favs = [
        { id: 'love-death-robots', title: 'Love Death & Robots', views: '2.4M' },
        { id: 'lucifer', title: 'Lucifer Morningstar', views: '3.1M' },
        { id: 'stranger-things-5', title: 'Stranger Things 5', views: '5.8M' },
        { id: 'black-widow', title: 'Black Widow', views: '1.9M' }
      ];
      favContainer.innerHTML = favs.map(f => `
        <div onclick="handleCardClick('${f.id}')" class="flex items-center justify-between p-2 rounded-xl cursor-pointer hover:bg-slate-800/80 transition-all group">
          <div class="flex items-center gap-2">
            <div class="w-1.5 h-1.5 rounded-full bg-red-500"></div>
            <h5 class="text-xs font-semibold group-hover:text-red-400 transition-colors line-clamp-1">${f.title}</h5>
          </div>
          <div class="flex items-center gap-1 text-[11px] text-slate-400 font-mono">
            <i data-lucide="eye" class="w-3 h-3 text-slate-500"></i>
            <span>${f.views}</span>
          </div>
        </div>
      `).join('');
    }

    // 17. CLOCK ENGINE
    function startClock() {
      function update() {
        const now = new Date();
        const timeStr = now.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', hour12: true });
        const day = now.getDate();
        const month = now.toLocaleDateString('en-US', { month: 'short' });
        document.getElementById('clockTime').textContent = timeStr;
        document.getElementById('clockDate').textContent = `${day}th ${month} 2026`;
      }
      update();
      setInterval(update, 1000);
    }

    // ON DOM LOAD
    window.addEventListener('DOMContentLoaded', () => {
      renderHomeCards();
      renderUpcomingCards();
      renderSidebarExtras();
      initAds();
      startClock();
      lucide.createIcons();
    });
  </script>
</body>
